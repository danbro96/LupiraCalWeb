      "get": {
        "tags": [
          "Ping"
        ],
        "summary": "Authenticated claims echo for dependency probes; resolves nothing, writes nothing.",
        "operationId": "Ping",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingDto"
