{
  "openapi": "3.1.1",
  "info": {
    "title": "Lupira Comms API",
    "description": "The comms substrate for Lupira: message ingestion, a per-user corpus, semantic topic segmentation, and closed-topic delivery to the assistant. Authenticate with a Bearer token issued by Authentik (owner surface) or service auth (internal hops).",
    "version": "v1"
  },
