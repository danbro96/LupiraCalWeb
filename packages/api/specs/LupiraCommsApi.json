  "components": {
    "schemas": {
      "ArcDetailDto": {
        "required": [
          "id",
          "label",
          "openedAt",
          "lastLinkedAt",
          "topics"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastLinkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicSummaryDto"
            }
          }
        },
        "description": "An arc with its member topics (`GET /arcs/{id}`)."
      },
      "ArchiveSearchHitDto": {
        "required": [
          "messageId",
          "conversationId",
          "timestamp",
          "source",
          "text",
          "score"
        ],
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "description": "The thread the message belongs to — the jump target for the archive browser.",
