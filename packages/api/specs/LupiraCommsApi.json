      "IngestMessageRequest": {
        "required": [
          "principalId",
          "source",
          "sourceRef",
          "text",
          "timestamp",
          "conversationRef"
        ],
        "type": "object",
        "properties": {
          "principalId": {
            "type": "string",
            "description": "The owner this message belongs to — relayed by the service caller, never inferred."
          },
          "source": {
            "$ref": "#/components/schemas/MessageSource"
          },
          "sourceRef": {
            "type": "string",
