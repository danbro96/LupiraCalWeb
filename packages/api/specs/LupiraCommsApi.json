          "replyToSourceRef": {
            "type": [
              "null",
              "string"
            ],
            "description": "The replied-to message's string IngestMessageRequest.SourceRef, when the platform carries one —\n            the topic engine attaches a reply to its parent's topic unconditionally."
          },
          "senderRef": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional platform sender id; resolves/creates a `Participant` when present."
          },
          "senderName": {
            "type": [
              "null",
              "string"
            ]
          },
          "fromPrincipal": {
            "type": "boolean",
            "description": "True when the owner sent this message (the connector's direction bit). Defaults false, so\n            older/importer callers that don't set it are treated as received."
          },
          "importBatch": {
            "type": [
              "null",
              "string"
            ],
            "description": "Set by the historical importer to tag the import run; null for live ingest."
          },
          "attachmentPath": {
            "type": [
              "null",
              "string"
            ],
            "description": "Export-root-relative path of the message's media file, if any — the media import\n            phase uploads it and stamps the row's object key. Null for live ingest (sidecars skip media)."
          }
        },
        "description": "A normalised message from a connector sidecar (or the historical importer). The connector\nguarantees string IngestMessageRequest.SourceRef is unique within MessageSource IngestMessageRequest.Source for the principal — it\nis the dedup key. string IngestMessageRequest.ConversationRef groups messages into a thread; the sender fields\nresolve a `Participant`."
      },
