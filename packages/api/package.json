{
  "name": "@lupira/cal-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "npm run spec && npm run routes && orval && npm run postgen",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postgen": "node postgen.mjs",
    "routes": "node routes.mjs",
    "spec": "dotnet build ../../src/LupiraCalBff/LupiraCalBff.csproj -v q --nologo"
  },
  "exports": {
    "./transport": "./src/transport.ts",
    "./models": "./src/generated/models/index.ts",
    "./query/*": "./src/generated/query/*/*.ts",
    "./fetch/*": "./src/generated/fetch/*/*.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4"
  }
}
