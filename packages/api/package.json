{
  "name": "@lupira/cal-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:specs": "node -e \"const fs=require('fs');for(const n of ['LupiraCalApi','LupiraGeoApi','LupiraContactApi','LupiraTasksApi','LupiraLocationApi','LupiraPhotoApi','LupiraCommsApi'])fs.copyFileSync('../../../'+n+'/openapi/'+n+'.json','specs/'+n+'.json')\"",
    "merge": "node merge-specs.mjs",
    "gen": "npm run sync:specs && npm run merge && orval",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    "./transport": "./src/transport.ts",
    "./models": "./src/generated/models/index.ts",
    "./query/*": "./src/generated/query/*/*.ts",
    "./fetch/*": "./src/generated/fetch/*/*.ts"
  }
}
