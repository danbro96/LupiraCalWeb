{
  "name": "lupira-cal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync:maplibre",
    "build": "tsc -b && vite build",
    "prebuild": "npm run sync:maplibre",
    "sync:maplibre": "node -e \"const fs=require('fs'),p=require('path');const d=p.join(p.dirname(require.resolve('maplibre-gl/package.json')),'dist');fs.mkdirSync('public/maplibre',{recursive:true});for(const f of['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])fs.copyFileSync(p.join(d,f),p.join('public/maplibre',f))\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "cp ../../../LupiraCalApi/openapi/LupiraCalApi.json backend-openapi.json && cp ../../../LupiraGeoApi/openapi/LupiraGeoApi.json backend-geo-openapi.json && cp ../../../LupiraContactApi/openapi/LupiraContactApi.json backend-contact-openapi.json && cp ../../../LupiraTasksApi/openapi/LupiraTasksApi.json backend-tasks-openapi.json && cp ../../../LupiraLocationApi/openapi/LupiraLocationApi.json backend-location-openapi.json && orval"
  },
  "dependencies": {
    "@lupira/cal-domain": "*",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.11.2",
    "maplibre-gl": "^6.1.0",
    "pmtiles": "^4.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "orval": "^8.23.0",
    "vite": "^8.0.16"
  }
}
