{
  "name": "lupira-cal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "cp ../../../LupiraCalApi/openapi/LupiraCalApi.json backend-openapi.json && cp ../../../LupiraGeoApi/openapi/LupiraGeoApi.json backend-geo-openapi.json && cp ../../../LupiraContactApi/openapi/LupiraContactApi.json backend-contact-openapi.json && orval"
  },
  "dependencies": {
    "@lupira/cal-domain": "*",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "orval": "^8.23.0",
    "vite": "^8.0.16"
  }
}
