{
  "expo": {
    "name": "Lupira Calendar",
    "slug": "lupira-calendar",
    "version": "0.1.0",
    "scheme": "lupiracalendar",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.lupira.calendar",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
