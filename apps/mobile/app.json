{
  "expo": {
    "name": "Lupira Calendar",
    "slug": "lupira-calendar",
    "version": "1.0.0",
    "scheme": "lupiracalendar",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0ba754c0-d8ce-42b5-a6b0-d0e7dd20c710"
    },
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.lupira.calendar",
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      "expo-image",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo",
            "video"
          ],
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lupira Calendar shows where you are on the map.",
          "locationAlwaysAndWhenInUsePermission": "Lupira Calendar records your route in the background so your movement history and photo places have no gaps.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "owner": "danbro96",
    "extra": {
      "eas": {
        "projectId": "0ba754c0-d8ce-42b5-a6b0-d0e7dd20c710"
      }
    }
  }
}
