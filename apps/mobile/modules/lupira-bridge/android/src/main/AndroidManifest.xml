<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Merged into the app manifest by the library merger — this is what makes the module approach
       survive prebuild without any config-plugin manifest surgery. -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.WRITE_CONTACTS" />
  <!-- Install-time (non-runtime) permissions: setSyncAutomatically/setIsSyncable need WRITE. -->
  <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
  <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

  <application>
    <service
      android:name="expo.modules.lupirabridge.AuthenticatorService"
      android:exported="false">
      <intent-filter>
        <action android:name="android.accounts.AccountAuthenticator" />
      </intent-filter>
      <meta-data
        android:name="android.accounts.AccountAuthenticator"
        android:resource="@xml/lupira_authenticator" />
    </service>

    <service
      android:name="expo.modules.lupirabridge.CalendarSyncService"
      android:exported="true">
      <intent-filter>
        <action android:name="android.content.SyncAdapter" />
      </intent-filter>
      <meta-data
        android:name="android.content.SyncAdapter"
        android:resource="@xml/lupira_syncadapter_calendar" />
    </service>

    <service
      android:name="expo.modules.lupirabridge.ContactsSyncService"
      android:exported="true">
      <intent-filter>
        <action android:name="android.content.SyncAdapter" />
      </intent-filter>
      <meta-data
        android:name="android.content.SyncAdapter"
        android:resource="@xml/lupira_syncadapter_contacts" />
      <meta-data
        android:name="android.provider.CONTACTS_STRUCTURE"
        android:resource="@xml/lupira_contacts" />
    </service>

    <!-- Taps on the "Open in Lupira" contact row land here; we resolve the Data row to the contact id
         and bounce into the app via its deep-link scheme. -->
    <activity
      android:name="expo.modules.lupirabridge.BridgeOpenActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="vnd.android.cursor.item/vnd.com.lupira.calendar.contact" />
      </intent-filter>
    </activity>
  </application>
</manifest>
